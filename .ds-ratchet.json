  "baseline": ".ds-baseline.json",
  "use": ["hex", "rgb-hsl", "arbitrary-color", "arbitrary-size", "palette", "inline-style", "raw-button", "raw-input", "raw-select", "raw-textarea", "raw-table", "overlay", "dark-variant"],
